# ================================
# SERVIDOR - probakgo (Go)
# ================================
# Copia este archivo a .env y ajusta los valores.
# Ver .env.server.example para documentación completa del servidor.
# Ver .env.client.example para configuración del cliente (nodo Proxmox).

API_HOST=0.0.0.0
API_PORT=36748

DATABASE_PATH=./probakgo_data.db

# Si faltan, el servidor genera ambas claves con entropía criptográfica y las
# persiste en .env. No reutilices los ejemplos ni pierdas DATA_ENCRYPTION_KEY.
# SESSION_KEY=<secreto-de-al-menos-32-bytes>
# DATA_ENCRYPTION_KEY=<secreto-de-al-menos-32-bytes>

TIMEZONE=Europe/Madrid

# Marcar true si el servidor está detrás de HTTPS (activa Secure en la cookie de sesión)
SESSION_SECURE=false

# Orígenes completos de confianza para CSRF, separados por coma.
# CSRF_TRUSTED_ORIGINS=https://mi-dominio.com,http://localhost:36748

# Activa la barra de debug en la interfaz web (solo desarrollo)
# DEV=true

# Token de GitHub para auto-update desde repos privados
# GITHUB_TOKEN=ghp_...
