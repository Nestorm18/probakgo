#!/bin/sh
# Runs the mandatory push checks from AGENTS.md ("Push verification").
# Enable it once per clone with: git config core.hooksPath .githooks

set -e

echo "pre-push: git diff --check"
git diff --check

echo "pre-push: build and vet"
go build ./...
go vet ./...
GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go vet ./client-windows/

echo "pre-push: vulnerability scan"
go run golang.org/x/vuln/cmd/govulncheck@v1.1.4 ./...

echo "pre-push: tests with coverage"
profile=$(mktemp)
trap 'rm -f "$profile"' EXIT
go test -coverprofile="$profile" ./...
total=$(go tool cover -func="$profile" | awk '/^total:/ {gsub("%", "", $3); print $3}')
echo "pre-push: total coverage ${total}%"
if ! awk -v total="$total" 'BEGIN { exit !(total + 0 >= 35) }'; then
    echo "pre-push: coverage ${total}% is below the 35% CI floor" >&2
    exit 1
fi
